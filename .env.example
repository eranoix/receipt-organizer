# Postgres. docker compose publishes it on 5611.
DATABASE_URL=postgres://receipts:receipts@localhost:5611/receipts

# Where the local fake drive lives. The web app and the worker must share it.
DRIVE_ROOT=./.data/drive

# Drive adapter: "local" (default, a directory plus a change feed) or "graph".
DRIVE_ADAPTER=local
# Only read when DRIVE_ADAPTER=graph.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_DRIVE_ID=

# Extractor: "mock" (default, deterministic) or "http" (an OCR/LLM service).
EXTRACTOR=mock
EXTRACTOR_URL=
EXTRACTOR_API_KEY=
# Hosts the http extractor and file downloads may reach. Suffix match on a leading dot.
EXTRACTOR_ALLOWED_HOSTS=.example.com

# Payment provider: "mock" is the only built-in one.
PAYMENT_PROVIDER=mock

# Set to "true" behind HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=false
